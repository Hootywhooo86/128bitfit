{
  "name": "128bitfit",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "Fitness + nutrition offline-first Expo app",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:exercises": "node scripts/build-exercise-db.mjs",
    "build:exercises:images": "node scripts/build-exercise-db.mjs --images",
    "build:foods": "node scripts/build-food-db.mjs",
    "check:usda": "node scripts/check-usda.mjs",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "verify:import": "node scripts/verify-import.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "expo export -p web",
    "serve:web": "node scripts/serve-web.mjs",
    "lint": "expo lint"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/silkscreen": "^0.4.2",
    "@kingstinct/react-native-healthkit": "^16.0.0",
    "@maplibre/maplibre-react-native": "^11.4.0",
    "@react-native-community/datetimepicker": "^9.2.1",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@types/geojson": "^7946.0.16",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.44.7",
    "expo": "~57.0.24",
    "expo-build-properties": "~57.0.21",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.19",
    "expo-document-picker": "^57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image-manipulator": "^57.0.19",
    "expo-keep-awake": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.20",
    "expo-router": "~57.0.22",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-task-manager": "~57.0.20",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "^15.15.5",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-plugin-inline-import": "^3.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "playwright": "^1.63.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.2",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=18"
  }
}
