{
  "expo": {
    "name": "128BIT FIT",
    "slug": "128bitfit",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "bitfit",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow 128BIT FIT to scan food barcodes.",
        "NSLocationWhenInUseUsageDescription": "Allow 128BIT FIT to record the route of your walks, runs and rides. It stays on this phone."
      }
    },
    "android": {
      "package": "com.hootywhooo86.bit128fit",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_BASAL_METABOLIC_RATE",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.READ_HYDRATION",
        "android.permission.health.READ_NUTRITION",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_ACTIVE_CALORIES_BURNED",
        "android.permission.health.WRITE_BODY_FAT",
        "android.permission.health.WRITE_DISTANCE",
        "android.permission.health.WRITE_EXERCISE",
        "android.permission.health.WRITE_HEART_RATE",
        "android.permission.health.WRITE_HYDRATION",
        "android.permission.health.WRITE_NUTRITION",
        "android.permission.health.WRITE_STEPS",
        "android.permission.health.WRITE_WEIGHT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow 128BIT FIT to scan food barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#ffffff",
          "defaultChannel": "rest_timer",
          "sounds": [
            "./assets/sounds/rest_beep.wav",
            "./assets/sounds/rest_chime.wav",
            "./assets/sounds/rest_bell.wav",
            "./assets/sounds/rest_arcade.wav",
            "./assets/sounds/rest_buzz.wav"
          ]
        }
      ],
      "expo-secure-store",
      "react-native-health-connect",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow 128BIT FIT to record the route of your walks, runs and rides. It stays on this phone.",
          "isAndroidForegroundServiceEnabled": true,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-sharing",
      "expo-build-properties",
      "./plugins/with-latin-only-mlkit"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
